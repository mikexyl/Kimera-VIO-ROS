<launch>
  <arg name="camera_name" default="alphasense_driver_ros/cam0/debayered"/>
  <arg name="online" default="true" />
  <arg name="log_output" default="false"/>
  <arg name="rosbag_path" default="path" />
  <arg name="config_type" default="SpiresMonoXfeat" />
  <arg name="seq" default="05"/>
  <arg name="gt_csv_file" default=""/>
  <arg name="robot_id" default="0" />
  <param name="use_sim_time" value="true"/>
  <arg name="debug" default="0" />
  <arg name="result_dir" value="$(find kimera_vio_ros)/output_logs/$(arg config_type)/$(arg seq)/results"/>

  <arg name="do_coarse_temporal_sync" default="false"/>
  <arg name="do_fine_temporal_sync" default="false"/>
  <arg name="use_external_odom" default="false"/>
  <arg name="use_lcd" default="2"/>
  <arg name="lcd_no_optimize" default="false"/>
  <arg name="lcd_no_detection" default="false"/>

  <arg name="use_visualizer" default="2"/>

  <!-- Other settings -->
  <arg name="log_gt_data" default="true"/>
  <arg name="should_use_sim_time" default="true"/>
  <arg name="params_folder" value="$(find kimera_vio)/params/$(arg config_type)"/>
  <arg if="$(arg log_output)" name="log_output_path" value="$(find kimera_vio_ros)/output_logs/$(arg config_type)"/>

  <!-- Subscribed Topics -->
  <arg name="left_cam_topic" value="/alphasense_driver_ros/cam0/color/image"/>
  <arg name="right_cam_topic" value="/$(arg camera_name)/image"/>
  <arg name="imu_topic" value="/alphasense_driver_ros/imu" />
  <!-- Only used when parsing a rosbag -->
  <arg name="external_odom_topic" value="/jackal_velocity_controller/odom"/>
  <arg name="close_on_error" value="false"/>

  <!-- <node pkg="image_transport" type="republish" name="image_republish" output="screen" args="compressed raw">
    <remap from="in" to="$(arg left_cam_topic)"/>
    <remap from="out" to="$(arg left_cam_topic)"/>
  </node> -->

  <!-- Launch actual pipeline -->
  <include file="$(find kimera_vio_ros)/launch/kimera_vio_ros.launch" pass_all_args="true"/>

  <include file="$(find raw_image_pipeline_ros)/launch/raw_image_pipeline_node.launch" pass_all_args="false">
    <arg name="input_topic"  default="alphasense_driver_ros/cam0/debayered/image/compressed"/>
    <arg name="debayer/enabled"                      default="false"/>
    <arg name="flip/enabled"                         default="false"/>
    <arg name="white_balance/enabled"                default="false"/>
    <arg name="color_calibration/enabled"            default="true"/>
    <arg name="gamma_correction/enabled"             default="false"/>
    <arg name="vignetting_correction/enabled"        default="false"/>
    <arg name="color_enhancer/enabled"               default="false"/>
    <arg name="undistortion/enabled"                 default="false"/>
  </include>

</launch>
